{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "project_summary": {
      "type": "object",
      "properties": {
        "product_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "primary_actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "primary_outcome": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "main_runtime": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "not_the_product": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          }
        }
      },
      "required": [
        "product_type",
        "primary_actor",
        "primary_outcome",
        "main_runtime",
        "not_the_product"
      ],
      "additionalProperties": false
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "mechanism": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "use_when": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "distinguish": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "plain_summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "importance": {
            "type": "string",
            "enum": [
              "core-journey",
              "differentiator",
              "dependent-capability",
              "supporting"
            ]
          },
          "user_actor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "user_goal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "visible_outcome": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "product_surface": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "causal_flow": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "why_one_capability": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "implementation_modules": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 12000
                },
                "classification": {
                  "type": "string",
                  "enum": [
                    "core",
                    "supporting"
                  ]
                },
                "responsibility": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 12000
                },
                "handoff": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 12000
                }
              },
              "required": [
                "path",
                "classification",
                "responsibility",
                "handoff"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "source_feature_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            },
            "minItems": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            },
            "minItems": 1
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 12000
                },
                "line_start": {
                  "type": "integer",
                  "minimum": 1
                },
                "line_end": {
                  "type": "integer",
                  "minimum": 1
                },
                "claim": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 12000
                }
              },
              "required": [
                "path",
                "line_start",
                "line_end",
                "claim"
              ],
              "additionalProperties": false
            },
            "minItems": 3
          }
        },
        "required": [
          "id",
          "title",
          "summary",
          "mechanism",
          "question",
          "use_when",
          "distinguish",
          "plain_summary",
          "importance",
          "user_actor",
          "user_goal",
          "visible_outcome",
          "product_surface",
          "causal_flow",
          "why_one_capability",
          "implementation_modules",
          "source_feature_ids",
          "evidence_ids",
          "source_refs"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "module_dispositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "disposition": {
            "type": "string",
            "enum": [
              "core-capability",
              "supporting",
              "excluded"
            ]
          },
          "capability_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          }
        },
        "required": [
          "path",
          "disposition",
          "capability_ids",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "schema_version": {
      "type": "string",
      "const": "repo-teacher-capability-inventory/v1"
    },
    "grouping_complete": {
      "type": "boolean",
      "const": true
    },
    "generator": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        }
      },
      "required": [
        "name",
        "method"
      ],
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "commit": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 12000
        },
        "branch": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 12000
        },
        "analysis_fingerprint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        }
      },
      "required": [
        "name",
        "path",
        "commit",
        "branch",
        "analysis_fingerprint"
      ],
      "additionalProperties": false
    },
    "source_manifest_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "cache_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "validation_artifact": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    }
  },
  "required": [
    "project_summary",
    "capabilities",
    "module_dispositions",
    "schema_version",
    "grouping_complete",
    "generator",
    "project",
    "source_manifest_sha256",
    "cache_key",
    "validation_artifact"
  ],
  "additionalProperties": false,
  "$id": "https://repolens.local/schemas/capability-inventory-v1.schema.json",
  "title": "RepoLens Capability Inventory v1"
}
